{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "mapbox-devkit": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@mapbox/mcp-devkit-server"
      ],
      "env": {
        "MAPBOX_ACCESS_TOKEN": "${MAPBOX_DEVKIT_TOKEN}",
        "PATH": "C:/Program Files/nodejs;C:/Windows/system32;C:/Windows"
      }
    }
  }
}
