# Flutter / Dart
# `pubspec.lock` est VOLONTAIREMENT versionné : c'est une application, pas une lib
# (cadrage §13.11, « fichiers de verrouillage commités »).
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/
.pub-cache/
build/
coverage/
doc/api/

