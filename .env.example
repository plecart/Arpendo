# Modèle de variables d'environnement — À COPIER EN `.env`, JAMAIS À COMMITTER.
# `.env` est ignoré par git (cadrage §13.10 : « Secrets — jamais dans le dépôt »).
# En CI et en production : secrets GitHub Actions, rotation documentée.

# ─── Mapbox ────────────────────────────────────────────────────────────────────
# DEUX jetons différents, ne pas les confondre :
#  - le jeton PUBLIC (pk.*) part dans l'APK et sert à charger les tuiles. Il EST extractible
#    (cadrage §13.10, risque n°1). Le restreindre aux scopes de lecture de tuiles et poser une
#    alerte de facturation dès le 1er dollar.
#  - le jeton de TÉLÉCHARGEMENT (sk.*, scope DOWNLOADS:READ) sert uniquement à récupérer le SDK
#    Android au moment du build. Il ne doit jamais partir dans l'APK.
MAPBOX_PUBLIC_TOKEN=pk.remplacer
MAPBOX_DOWNLOADS_TOKEN=sk.remplacer

# ─── Authentification Google (cadrage §12.1) ───────────────────────────────────
# Le client WEB est celui que le backend valide (`aud` du jeton d'identité), même si
# l'application est Android. Voir documents/setup/google-oauth.md.
GOOGLE_WEB_CLIENT_ID=remplacer.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=remplacer.apps.googleusercontent.com

# ─── Base de données (cadrage §13.6, §13.7) ────────────────────────────────────
# PostgreSQL 17. En production : réseau privé, aucune IP publique.
DATABASE_URL=postgresql+asyncpg://arpendo:arpendo@localhost:5432/arpendo

# ─── Valkey (cadrage §13.0) ────────────────────────────────────────────────────
# Mot de passe REQUIS même en local : aucun port publié en production, mais l'habitude
# de tourner sans mot de passe finit par se retrouver en production.
VALKEY_URL=redis://localhost:6379/0
VALKEY_PASSWORD=remplacer

# ─── Sessions ──────────────────────────────────────────────────────────────────
# Clé de signature des jetons de session émis par l'api (distincts du jeton Google).
# Générer avec : uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=remplacer

# ─── Observabilité (cadrage §13.11) ────────────────────────────────────────────
# Scrubbing PII obligatoire. Échantillonnage dès le jour 1 : 5 000 erreurs/mois se
# consomment en heures si une exception boucle.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Notifications push (cadrage §14.2) ────────────────────────────────────────
# Chemin vers le fichier de compte de service FCM. Le fichier lui-même reste hors dépôt.
FCM_SERVICE_ACCOUNT_FILE=./secrets/fcm-service-account.json

# ─── Application ───────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
